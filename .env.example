# =====================================================================
#  copycow.exe settings — copy this file to ".env" (npm run setup does it)
#  Lines starting with # are notes. Empty values are fine: COWBOT skips
#  anything it doesn't have a key for and tells you with a "TODO" message.
# =====================================================================

# ---------------------------------------------------------------------
# THE BIG SWITCH
# paper = simulate token launches, fee claims and airdrops (DEFAULT, SAFE)
# real  = launch real coins on pump.fun, sell the launch buys (2x / 24h),
#         claim real creator rewards and send real holder airdrops.
#         Only flip this after the go-live checklist.
# (Momentum trading is ALWAYS paper in this version — there is no real
#  trading code for it.)
# ---------------------------------------------------------------------
LAUNCH_MODE=paper

# Which Solana network COWBOT ACTS on (its wallet, the money contract, airdrops):
#   mainnet = the real network · devnet = Solana's free TEST network (test SOL)
# `npm run devnet:setup` sets this for you. Prices + rug checks always use mainnet data.
SOLANA_NETWORK=mainnet
# Devnet only: biggest weekly test airdrop, in test SOL
DEVNET_AIRDROP_MAX_SOL=1

# ---------------------------------------------------------------------
# API KEYS (all free tiers)
# ---------------------------------------------------------------------
# Helius — fast Solana connection. https://dev.helius.xyz  (sign up → copy API key)
HELIUS_API_KEY=
# Optional: any other Solana RPC URL (overrides Helius)
SOLANA_RPC_URL=
# Birdeye — backup price feed. https://docs.birdeye.so  (optional)
BIRDEYE_API_KEY=
# Jupiter — prices + swap quotes. Works WITHOUT a key (free "lite" API).
# Optional key from https://station.jup.ag / https://portal.jup.ag
JUPITER_API_KEY=
# X (Twitter) API v2 bearer token. https://developer.x.com → Projects & Apps → Keys and tokens
X_BEARER_TOKEN=
# Optional: AI images for launched tokens (otherwise a plain colored square)
OPENAI_API_KEY=

# ---------------------------------------------------------------------
# TRADING STRATEGY (paper)
# ---------------------------------------------------------------------
# How often COWBOT checks the market ("*/5 * * * *" = every 5 minutes)
CYCLE_CRON=*/5 * * * *
# How many top-volume tokens to watch
UNIVERSE_SIZE=10
# Buy when the 15-minute price change is at least this % ...
MOMENTUM_15M_THRESHOLD_PCT=1.0
# ... but NOT more than this % (anything hotter is a pump — no FOMO)
MAX_MOMENTUM_15M_PCT=8
# Last hour's volume must be at least this many times its 24h average pace
MIN_VOLUME_PACE=1.0
TAKE_PROFIT_PCT=3
STOP_LOSS_PCT=1.5
MAX_POSITIONS=3
# Paper position size, in SOL
TRADE_SIZE_SOL=1
# Close a position after this long even if TP/SL wasn't hit
MAX_HOLD_MINUTES=240
# After a loss, don't touch that token again for this long (no revenge trades)
COOLDOWN_AFTER_LOSS_MINUTES=120
# Junk / scam filters
MIN_LIQUIDITY_USD=250000
MIN_UNIQUE_BUYERS_24H=300
# Skip pools younger than this (fresh relaunches are usually rugs)
MIN_POOL_AGE_HOURS=72
# Skip tokens worth less than this
MIN_MARKET_CAP_USD=5000000
# Skip tokens whose daily volume is more than this many times their market cap (fake/wash volume)
MAX_VOLUME_TO_MARKET_CAP=3
# Rug checks (before trading any token): blocks tokens whose creator can freeze
# wallets, take tokens, pause transfers or mint more, or with a high RugCheck score.
RUG_CHECK_ENABLED=true
RUG_BLOCK_MINT_AUTHORITY=true
# RugCheck.xyz overall risk score (0 safe … 100 risky) that blocks a token
RUG_MAX_RISK_SCORE=75
# Token addresses you trust despite mint authority (e.g. bridged coins like HYPE, ZEC), comma-separated
RUG_ALLOWLIST=
# Starting balance of the paper account (for return % and charts)
PAPER_STARTING_CAPITAL_SOL=100

# ---------------------------------------------------------------------
# TREND SCANNER (X + Solana)
# ---------------------------------------------------------------------
SCAN_CRON=*/30 * * * *
# Free X tier ≈ 100 posts read per month. COWBOT never goes over this.
X_MONTHLY_POST_BUDGET=100
# Posts per X read (10 = minimum). 100 budget / 10 = one X read every ~3 days.
X_POSTS_PER_SCAN=10
# A trend must spike by more than this % vs its 24h average (500 = 6x)
VELOCITY_SPIKE_PCT=500
# Minimum score (0-100) before COWBOT launches a token for a trend
LAUNCH_SCORE_THRESHOLD=75
# Hours of scanning history needed before the first launch
SCANNER_WARMUP_HOURS=6
# Tokens already worth more than this are "large caps" — never copied
LARGE_CAP_FDV_USD=50000000

# ---------------------------------------------------------------------
# TOKEN LAUNCHER (hard rules: max 1 launch per 24h, max 2 SOL per buy)
# ---------------------------------------------------------------------
# SOL spent on the first buy of each launched token
LAUNCH_BUY_SOL=0.5
# Total SOL COWBOT may ever spend on launches
LAUNCH_TOTAL_BUDGET_SOL=5
# COWBOT sells its launch buy when it's worth this many times what it cost...
LAUNCH_TAKE_PROFIT_X=2
# ...or after this many hours, whichever comes first. Profit → $COPYCOW holders.
LAUNCH_MAX_HOLD_HOURS=24
# Never launch if the wallet would drop below this
WALLET_FLOOR_SOL=2
# Pretend treasury balance used in paper mode
PAPER_TREASURY_START_SOL=10
TOKEN_SOCIAL_X=https://x.com/copycowexe
TOKEN_WEBSITE=https://copycow.xyz

# ---------------------------------------------------------------------
# CREATOR REWARDS (pump.fun) — hard-coded, NOT settings:
#   $COPYCOW's rewards:      10% → COWBOT (never more) · 90% → TEAM_WALLET (marketing)
#   a launched coin's rewards: 100% → that coin's holders (daily airdrop)
# ---------------------------------------------------------------------
# The team's wallet address. Once COPYCOW_MINT is set, COWBOT refuses to
# claim creator rewards until this is set too. Must NOT be COWBOT's wallet.
TEAM_WALLET=
FEE_POLL_CRON=*/30 * * * *
# Paper-mode reward estimate: creator fee rate (bps) × share of (sanity-capped) trend volume captured (%)
CREATOR_FEE_BPS_ESTIMATE=5
PAPER_FEE_CAPTURE_PCT=2
# Real mode: only claim creator rewards once at least this much is waiting
CREATOR_FEE_CLAIM_MIN_SOL=0.01

# ---------------------------------------------------------------------
# AIRDROPS (holders never click claim)
#   weekly: ALL COWBOT profit (trading + launch sales) + copytrade fees → $COPYCOW holders
#           (losing weeks are made back before anything is paid)
#   daily:  each launched coin's creator rewards → that coin's holders
# ---------------------------------------------------------------------
COIN_AIRDROP_CRON=20 0 * * *
# Minimum of a launched coin someone must hold to get its rewards airdrop
COIN_AIRDROP_MIN_TOKENS=1
# Your $COPYCOW token address — fill in after launching on pump.fun
COPYCOW_MINT=
# Weekly $COPYCOW airdrop time (Mondays 00:05 UTC)
AIRDROP_CRON=5 0 * * 1
# Minimum $COPYCOW to receive the airdrop (100K = CALF tier)
AIRDROP_MIN_TOKENS=100000
# Skip payouts smaller than this (they roll over to next week)
AIRDROP_MIN_PAYOUT_SOL=0.001
# Comma-separated wallets to never airdrop to (e.g. team, exchange wallets)
AIRDROP_EXCLUDE_WALLETS=
# Fill in after deploying the contracts (npm run init:programs prints it)
DIVIDEND_PROGRAM_ID=
TREASURY_DAILY_LIMIT_SOL=2

# ---------------------------------------------------------------------
# DAILY RECAP (written to content/daily/)
# ---------------------------------------------------------------------
RECAP_CRON=55 23 * * *

# ---------------------------------------------------------------------
# COPYTRADE ENGINE (paper)
# ---------------------------------------------------------------------
ENGINE_PORT=8787
ENGINE_POLL_SECONDS=10
# Performance fee on PROFITABLE copied trades (500 = 5%). Split 10/90 like everything else.
COPYTRADE_PERF_FEE_BPS=500

# ---------------------------------------------------------------------
# HOSTED WEBSITE (Vercel) — COWBOT publishes the dashboard data to a free
# Turso database; the Vercel site reads it. Leave empty if the website runs
# on the same computer as COWBOT. Setup: README → "Host the website on Vercel".
# ---------------------------------------------------------------------
# e.g. libsql://copycow-yourname.turso.io
TURSO_DATABASE_URL=
# On COWBOT's computer: a FULL-ACCESS token. (On Vercel: a READ-ONLY token.)
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------
# DASHBOARD
# ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://copycow.xyz
# Advanced: use a different database file (e.g. data/demo.db for the demo)
COPYCOW_DB_PATH=
